# Copie este arquivo para .env e preencha os valores abaixo.
# Este arquivo .env real nao deve ser versionado.

MAJU_WIFI_SSID="ssid"
MAJU_WIFI_PASSWORD="password"

# Temperatura da folha
# A partir da versao com sensores infravermelhos, T_folha e MEDIDA pelo MLX90614
# (fallback: media do frame do AMG8833). A variavel MAJU_LEAF_OFFSET_C foi removida;
# se ainda existir no seu .env ela e ignorada (o build emite um aviso).

# ThingSpeak
# 1/true/on/yes para ativar | 0/false/off/no para desativar
MAJU_THINGSPEAK_ENABLE="0"
MAJU_THINGSPEAK_WRITE_API_KEY=""
MAJU_THINGSPEAK_URL="https://api.thingspeak.com/update"

# MQTT
# 1/true/on/yes para ativar | 0/false/off/no para desativar
MAJU_MQTT_ENABLE="0"
# URI completa: mqtt://host:1883 (sem TLS) ou mqtts://host:8883 (com TLS via esp_crt_bundle)
MAJU_MQTT_BROKER_URI="mqtt://broker.example.com:1883"
MAJU_MQTT_USERNAME=""
MAJU_MQTT_PASSWORD=""
# Topico dos escalares (field1..field8&src=)
MAJU_MQTT_TOPIC="maju/vpd"
# Topico do frame 8x8 do AMG8833 em JSON (deve ser diferente de MAJU_MQTT_TOPIC)
MAJU_MQTT_THERMAL_TOPIC="maju/thermal"
MAJU_MQTT_CLIENT_ID="maju_vpd"
