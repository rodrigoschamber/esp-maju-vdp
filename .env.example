# Copie este arquivo para .env e preencha os valores abaixo.
# Este arquivo .env real nao deve ser versionado.

MAJU_WIFI_SSID="ssid"
MAJU_WIFI_PASSWORD="password"

# Offset aplicado no calculo: T_folha = T_ar - offset
# Use sinal + para folha mais fria (ex.: +2.0) e sinal - para folha mais quente (ex.: -1.0)
MAJU_LEAF_OFFSET_C="+2.0"

# ThingSpeak
# 1/true/on/yes para ativar | 0/false/off/no para desativar
MAJU_THINGSPEAK_ENABLE="1"
MAJU_THINGSPEAK_WRITE_API_KEY="SS1DBWLVD115JL81"
MAJU_THINGSPEAK_URL="https://api.thingspeak.com/update"
